# Copy to .env.local OR enter these values from the app Settings page.
# Never commit .env.local.

# Free search: ddgs requires no API key.
SEARCH_PROVIDER=ddgs
BRAVE_API_KEY=

# Free Gmail SMTP sender (recommended starter mode).
EMAIL_PROVIDER=gmail
GMAIL_ADDRESS=youraccount@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password

# Optional custom SMTP mode.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=

FROM_NAME=Export Team
REPLY_TO=
SENDER_COMPANY=Your Company LLC
SENDER_PHONE=+374...
SENDER_WEBSITE=https://example.com
MONTHLY_CAPACITY=20 MT/month
MOQ=1 x 20ft container
PRICE=EUR X.XX/kg
INCOTERM=FCA Armenia / CIF on request
